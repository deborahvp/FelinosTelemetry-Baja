# Copy to .env and fill in. Never commit .env.
# HiveMQ Cloud cluster host (without scheme), e.g. abc123.s1.eu.hivemq.cloud
MQTT_HOST=
# 8884 = MQTT over WebSocket + TLS (same as Sensor Logger and the dashboard)
MQTT_PORT=8884
MQTT_TRANSPORT=websockets
MQTT_WS_PATH=/mqtt
# Ingest user (subscribe-only permission is enough)
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=felinos/#
# Where stream backups are written (one NDJSON file per sessionId)
FELINOS_DATA_DIR=data/stream
